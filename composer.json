{
    "name": "uhifadhilabs/seeder-module",
    "description": "Seeder: dev/demo data seeding for uhifadhi hosts \u2014 demo accounts + positions, fixed-uuid area from a GeoJSON boundary, and the one-shot baseline orchestrator.",
    "type": "symfony-bundle",
    "keywords": [
        "seeding",
        "fixtures",
        "demo",
        "symfony",
        "uhifadhi"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/orm": "^3.5",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/password-hasher": "^7.3 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "UhifadhiLabs\\Seeder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UhifadhiLabs\\Seeder\\Tests\\": "tests/",
            "Uhifadhi\\": "tests/Fixtures/Uhifadhi/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2",
        "symfony/security-core": "^7.3 || ^8.0"
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
